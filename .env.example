# Copy to .env for local overrides. Real environment variables take precedence over .env.
# Prefix: APP_   Nesting: __   Lists/dicts: JSON, e.g. APP_CORS__ALLOW_ORIGINS=["https://app.example.com"]

# --- App ----------------------------------------------------------------------
APP_NAME=template-mcp
APP_VERSION=0.1.0
# development | test | staging | production
APP_ENVIRONMENT=development
APP_DEBUG=false
# Unset = enabled everywhere except production.
# APP_DOCS_ENABLED=true

# --- Server (uvicorn) ---------------------------------------------------------
APP_SERVER__HOST=127.0.0.1
APP_SERVER__PORT=8000
APP_SERVER__WORKERS=1
APP_SERVER__RELOAD=false
APP_SERVER__PROXY_HEADERS=true
# IPs of trusted reverse proxies/load balancers allowed to set X-Forwarded-*.
APP_SERVER__FORWARDED_ALLOW_IPS=127.0.0.1
APP_SERVER__ROOT_PATH=
APP_SERVER__TIMEOUT_KEEP_ALIVE=5
APP_SERVER__TIMEOUT_GRACEFUL_SHUTDOWN=30
# APP_SERVER__LIMIT_CONCURRENCY=1000

# --- Logging ------------------------------------------------------------------
APP_LOGGING__LEVEL=INFO
# json | console (unset = console in development/test, json elsewhere)
# APP_LOGGING__FORMAT=json
APP_LOGGING__ACCESS_LOG=true
# APP_LOGGING__ACCESS_LOG_EXCLUDE_PATHS=["/health/live","/health/ready"]
# Replaces the default per-logger overrides entirely:
# APP_LOGGING__LEVELS={"mcp.server.lowlevel.server":"WARNING","httpx":"WARNING"}

# --- CORS (only installed when ALLOW_ORIGINS is non-empty) ---------------------
# APP_CORS__ALLOW_ORIGINS=["https://app.example.com"]
# APP_CORS__ALLOW_CREDENTIALS=false

# --- MCP ----------------------------------------------------------------------
APP_MCP__ENABLED=true
APP_MCP__NAME=template-mcp
# APP_MCP__INSTRUCTIONS=Tools for ...
APP_MCP__PATH=/mcp
# true = no server-side sessions; any worker/replica can serve any request.
# Use when running multiple workers or replicas without sticky sessions.
APP_MCP__STATELESS_HTTP=false
# Plain JSON responses instead of SSE (stateless mode only).
APP_MCP__JSON_RESPONSE=false
APP_MCP__MASK_ERROR_DETAILS=true
APP_MCP__STRICT_INPUT_VALIDATION=false
APP_MCP__SESSION_IDLE_TIMEOUT=3600
# true | false | auto  (auto = validate Host/Origin when bound to localhost or when allowlists are set)
APP_MCP__HOST_ORIGIN_PROTECTION=auto
# Set in production for DNS-rebinding protection, e.g. ["mcp.example.com"]
# APP_MCP__ALLOWED_HOSTS=["mcp.example.com"]
# APP_MCP__ALLOWED_ORIGINS=["https://app.example.com"]

# --- MCP auth -----------------------------------------------------------------
# none | static | jwt | oauth
APP_MCP__AUTH__MODE=none
# For oauth, also the scopes requested at sign-in (unset = the provider's default).
# APP_MCP__AUTH__REQUIRED_SCOPES=["mcp:use"]

# static: bearer API keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# APP_MCP__AUTH__TOKENS=["key-one","key-two"]

# jwt: exactly one of JWKS_URI or PUBLIC_KEY; AUDIENCE is required.
# APP_MCP__AUTH__JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# APP_MCP__AUTH__ISSUER=https://your-idp.example.com/
# APP_MCP__AUTH__AUDIENCE=template-mcp
# APP_MCP__AUTH__ALGORITHM=RS256
# Publishes OAuth protected-resource metadata so MCP clients can discover the IdP:
# APP_MCP__AUTH__AUTHORIZATION_SERVERS=["https://your-idp.example.com/"]
# APP_MCP__AUTH__BASE_URL=https://mcp.example.com

# oauth: people sign in from MCP clients (Claude, Cursor, VS Code, ...) through GitHub, Google or
# any OIDC provider (Auth0, Okta, Keycloak, ...). Register an OAuth app with the provider whose
# callback URL is <BASE_URL>/auth/callback, e.g. http://localhost:8000/auth/callback locally
# (OAuth requires https everywhere except localhost).
# APP_MCP__AUTH__MODE=oauth
# APP_MCP__AUTH__BASE_URL=http://localhost:8000
# github | google | oidc
# APP_MCP__AUTH__PROVIDER=github
# APP_MCP__AUTH__CLIENT_ID=
# APP_MCP__AUTH__CLIENT_SECRET=
# oidc only: the discovery document, plus AUDIENCE for IdPs that need one to issue JWTs (Auth0).
# APP_MCP__AUTH__CONFIG_URL=https://your-tenant.auth0.com/.well-known/openid-configuration
# APP_MCP__AUTH__AUDIENCE=https://mcp.example.com
# Signs the tokens issued to MCP clients; same on every replica, and changing it signs everyone out.
# Unset = derived from CLIENT_SECRET. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_MCP__AUTH__JWT_SIGNING_KEY=
# mongo (sign-ins survive restarts and are shared by replicas) | memory (development only)
# APP_MCP__AUTH__STORAGE=mongo
# Who may sign in. Both unset = anyone with an account at the provider.
# GitHub usernames or verified emails:
# APP_MCP__AUTH__ALLOWED_USERS=["octocat","ada@example.com"]
# Verified email domains, matched exactly (not subdomains):
# APP_MCP__AUTH__ALLOWED_DOMAINS=["example.com"]

# --- MCP rate limiting (per process; use a gateway for global limits) --------
APP_MCP__RATE_LIMIT__ENABLED=false
APP_MCP__RATE_LIMIT__REQUESTS_PER_SECOND=10
# APP_MCP__RATE_LIMIT__BURST_CAPACITY=20

# --- Generated files & download links -----------------------------------------
# local (dev / single instance with a volume) | s3 (AWS S3, Cloudflare R2, MinIO)
APP_FILES__BACKEND=local
# Required outside development/test; identical on every replica.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_FILES__SIGNING_KEY=
APP_FILES__LINK_TTL_SECONDS=3600
# Origin used in links; unset = taken from the incoming request.
# APP_FILES__PUBLIC_BASE_URL=https://mcp.example.com
APP_FILES__LOCAL_DIR=.data/files
# S3 credentials come from the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars or an IAM role.
# Add a bucket lifecycle rule to expire old objects.
# APP_FILES__S3_BUCKET=generated-files
# APP_FILES__S3_PREFIX=files/
# APP_FILES__S3_REGION=us-east-1
# APP_FILES__S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# APP_FILES__S3_PRESIGN_TTL_SECONDS=60

# --- MongoDB ------------------------------------------------------------------
# Credentials go in the URL, e.g. mongodb+srv://user:pass@cluster.example.net
APP_MONGO__URL=mongodb://localhost:27017
APP_MONGO__DATABASE=template_mcp
APP_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000

# --- Templates & rendering -----------------------------------------------------
APP_TEMPLATES__MAX_TEMPLATE_BYTES=5242880
APP_TEMPLATES__MAX_SCHEMA_BYTES=262144
APP_TEMPLATES__MAX_DATA_BYTES=1048576
APP_TEMPLATES__RENDER_TIMEOUT_SECONDS=60
# Documents rendered at once per output format per worker; scale with APP_SERVER__WORKERS instead.
APP_TEMPLATES__RENDER_CONCURRENCY=1

# --- macOS local development ----------------------------------------------------
# WeasyPrint needs Homebrew's Pango (brew install pango), found via this path. macOS reads it
# only when Python starts, so the app reading .env is too late. Load .env into the process
# environment instead: PyCharm run configuration > "Paths to .env files", or
# `uv run --env-file .env python main.py` (and `uv run --env-file .env pytest`).
# Not needed on Linux or in Docker.
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib
